---
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/public.css";
import Seo, { type SeoImage } from "../components/Seo.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { createHash } from "node:crypto";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: SeoImage | undefined;
  noindex?: boolean;
  current?: "home" | undefined;
  type?: "website" | "article";
}

const { title, description, path, image, noindex, current, type } = Astro.props;
Astro.csp?.insertDirective("img-src 'self' data:");
// Runs before first paint: enables JS-only styles and decides on the first-visit loader (PD-05). A constant of
// ours (never data), rendered as is; Astro does not hash is:inline scripts, so its hash is added here (CSP, SECURITY §4).
const BOOT =
  '(function(d){var h=d.documentElement;h.classList.add("js");try{if(location.pathname==="/"&&!sessionStorage.getItem("ik-seen")&&!matchMedia("(prefers-reduced-motion: reduce)").matches)h.classList.add("is-loading")}catch(e){}})(document);';
Astro.csp?.insertScriptHash(`sha256-${createHash("sha256").update(BOOT).digest("base64")}`);
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={BOOT} />
    <Font cssVariable="--font-archivo" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-space-mono" />
    <Seo title={title} description={description} path={path} image={image} noindex={noindex} type={type} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip m" href="#sadrzaj">Prijeđi na sadržaj</a>
    <div class="grain" aria-hidden="true"></div>
    <slot name="overlay" />
    <Nav current={current} />
    <main id="sadrzaj" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <slot name="end" />
  </body>
</html>
