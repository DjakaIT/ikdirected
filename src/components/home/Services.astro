---
// Sticky card stack (reference §stack). PD-14: image = newest published cover in the category,
// static placeholder otherwise; each card links to its category page (AC-HOME-05).
import Picture from "../Picture.astro";
import { site, type CategorySlug } from "../../content/site";
import { categoryFallback } from "../../lib/data/placeholder";
import type { PublicPhoto } from "../../lib/data/types";

interface Props {
  covers: Partial<Record<CategorySlug, PublicPhoto>>;
}

const { covers } = Astro.props;
---

<section class="stack" id="usluge" aria-labelledby="usluge-title">
  <div class="stack__h">
    <h2 id="usluge-title">{site.servicesHeading}</h2>
    <span class="m dim">{site.servicesNote}</span>
  </div>

  {
    site.services.map((s) => (
      <article class="card">
        <div class="card__t">
          <div>
            <h3>
              <a href={`/radovi/${s.category}`}>{s.name}</a>
            </h3>
            <p>{s.text}</p>
          </div>
          <span class="m dim">{s.priceLine}</span>
        </div>
        <div class="card__i">
          <Picture photo={covers[s.category] ?? categoryFallback(s.category)} sizes="(max-width: 819px) 100vw, 40vw" fit="cover" />
        </div>
      </article>
    ))
  }
</section>

<style>
  .stack {
    padding: clamp(80px, 12vw, 150px) var(--pad) clamp(40px, 8vw, 90px);
  }
  .stack__h {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    flex-wrap: wrap;
    margin-bottom: clamp(24px, 4vw, 48px);
  }
  .stack__h h2 {
    font-size: var(--t-h2);
    font-weight: 500;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    font-stretch: 108%;
  }
  .card {
    position: sticky;
    background: var(--bg-2);
    border: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    margin-bottom: var(--s-4);
  }
  .card:nth-of-type(2) {
    top: 88px;
  }
  .card:nth-of-type(3) {
    top: 104px;
  }
  .card:nth-of-type(4) {
    top: 120px;
  }
  @media (min-width: 820px) {
    .card {
      grid-template-columns: 1.15fr 0.85fr;
      min-height: 340px;
    }
  }
  .card__t {
    padding: clamp(24px, 3vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }
  h3 {
    font-size: clamp(1.55rem, 3.1vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    font-stretch: 106%;
  }
  /* The whole card is one link target (stretched link). */
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .card:has(h3 a:focus-visible) {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }
  .card__t p {
    max-width: 42ch;
    color: var(--dim);
    margin-top: 12px;
  }
  .card__i {
    position: relative;
    min-height: 220px;
    overflow: hidden;
  }
  .card__i :global(.pic__img) {
    filter: brightness(0.9);
  }
</style>
