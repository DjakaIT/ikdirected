---
import { site } from "../../content/site";
---

<section class="faq" id="pitanja" aria-labelledby="pitanja-title">
  <span class="m dim">{site.faqLabel}</span>
  <h2 id="pitanja-title">{site.faqHeading}</h2>
  {
    site.faq.map((f) => (
      <div class="qa">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </div>
    ))
  }
</section>

<style>
  .faq {
    padding: clamp(80px, 12vw, 160px) var(--pad);
  }
  h2 {
    font-size: var(--t-h2);
    font-weight: 500;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    font-stretch: 108%;
    margin: 12px 0 clamp(30px, 5vw, 60px);
  }
  .qa {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    border-top: 1px solid var(--line);
    padding: clamp(22px, 2.6vw, 32px) 0;
  }
  .qa:last-of-type {
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 860px) {
    .qa {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 40px;
      align-items: start;
    }
  }
  h3 {
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  p {
    color: var(--dim);
    max-width: 56ch;
  }
</style>
