---
import { site } from "../content/site";
import { CONTACT_MAX } from "../lib/contact";
const year = new Date().getFullYear();
const form = site.contact.form;
const fields = [
  { id: "ime", type: "text", auto: "given-name", wide: false },
  { id: "prezime", type: "text", auto: "family-name", wide: false },
  { id: "email", type: "email", auto: "email", wide: true },
  { id: "naslov", type: "text", auto: "off", wide: true },
] as const;
const pad = (n: number) => String(n).padStart(2, "0");
---

<footer class="foot" id="kontakt">
  <span class="m dim">{site.contact.label}</span>
  <h2><a href={`mailto:${site.email}`}>{site.contact.heading[0]}<br />{site.contact.heading[1]}</a></h2>
  <div class="foot__body">
    <p class="foot__lead">{site.contact.lead}</p>
    <form
      class="cf"
      aria-label={form.name}
      novalidate
      data-contact
      data-to={site.email}
      data-errors={JSON.stringify(form.errors)}
      data-labels={JSON.stringify(form.fields)}
      data-prepared={form.prepared}
    >
      {
        fields.map((f, i) => (
          <div class:list={["fld", { "fld--wide": f.wide }]}>
            <label class="m fld__lab" for={`cf-${f.id}`}>
              <span>{form.fields[f.id]}</span>
              <span class="num fld__no" aria-hidden="true">{pad(i + 1)}</span>
            </label>
            <span class="fld__ctl">
              <input
                id={`cf-${f.id}`}
                name={f.id}
                type={f.type}
                autocomplete={f.auto}
                maxlength={CONTACT_MAX[f.id]}
                required
                aria-describedby={`cf-${f.id}-err`}
                spellcheck={f.type === "email" ? "false" : undefined}
              />
            </span>
            <span class="fld__err" id={`cf-${f.id}-err`} data-cf-err={f.id} />
          </div>
        ))
      }
      <div class="fld fld--wide">
        <label class="m fld__lab" for="cf-poruka">
          <span>{form.fields.poruka}</span>
          <span class="num fld__no" aria-hidden="true">{pad(fields.length + 1)}</span>
        </label>
        <span class="fld__ctl">
          <textarea
            id="cf-poruka"
            name="poruka"
            rows="5"
            maxlength={CONTACT_MAX.poruka}
            required
            aria-describedby="cf-poruka-err"></textarea>
        </span>
        <span class="fld__meta">
          <span class="fld__err" id="cf-poruka-err" data-cf-err="poruka"></span>
          <span class="m dim num" data-cf-count aria-hidden="true">0 / {CONTACT_MAX.poruka}</span>
        </span>
      </div>
      <div class="cf__send">
        <button class="cf__btn" type="submit"><span>{form.submit}</span><span class="cf__arr" aria-hidden="true">→</span></button>
        <p class="cf__status" role="status" data-cf-status>
          <span data-cf-status-text></span>
          <a class="cf__open" href={`mailto:${site.email}`} data-cf-open hidden>{form.openMail}</a>
        </p>
      </div>
    </form>
  </div>
  <div class="foot__g">
    <div><span class="m">E-mail</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
    <div><span class="m">Telefon</span><a href={site.phoneHref}>{site.phone}</a></div>
    <div>
      <span class="m">Instagram</span><a href={site.instagram.url} rel="me noopener" target="_blank"
        >{site.instagram.handle}</a
      >
    </div>
    <div><span class="m">Adresa</span><p>{site.address.display}</p></div>
  </div>
  <div class="foot__end m dim">
    <span class="num">© {year} {site.brand}</span>
    <span class="foot__links"><a href="/radovi">Svi radovi</a> · <a href="/privatnost">Privatnost</a></span>
    <span>Web: <a href={site.credit.url} target="_blank" rel="noopener">{site.credit.label}</a></span>
  </div>
</footer>

<script>
  import { initContact } from "../scripts/public/contact";
  initContact();
</script>

<style>
  .foot {
    padding: clamp(70px, 12vw, 160px) var(--pad) 30px;
    color: var(--fg);
  }
  h2 {
    margin-top: var(--s-4);
    font-size: clamp(2.6rem, 12vw, 11rem);
    line-height: 0.86;
    font-weight: 600;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    font-stretch: 112%;
  }
  h2 a {
    display: inline-block;
    transition: opacity var(--d-2) var(--ease-out);
  }
  h2 a:hover {
    opacity: 0.55;
  }
  .foot__body {
    display: grid;
    gap: var(--s-7);
    margin-top: 26px;
  }
  @media (min-width: 960px) {
    .foot__body {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(48px, 7vw, 128px);
      align-items: start;
    }
  }
  .foot__lead {
    max-width: 42ch;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
  }

  /* contact form — hairlines, mono labels, big type; square like the rest of the site */
  .cf {
    display: grid;
    gap: var(--s-6) var(--s-5);
  }
  /* without JS there is nothing to submit to yet (mail endpoint comes later): the links above stay */
  :global(html:not(.js)) .cf {
    display: none;
  }
  @media (min-width: 560px) {
    .cf {
      grid-template-columns: 1fr 1fr;
    }
    .fld--wide,
    .cf__send {
      grid-column: 1 / -1;
    }
  }
  .fld {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .fld__lab {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    color: var(--dim);
    transition: color var(--d-1) var(--ease-out);
  }
  .fld:focus-within .fld__lab {
    color: var(--fg);
  }
  .fld__ctl {
    position: relative;
    display: block;
    margin-top: var(--s-2); /* keeps the PD-13 focus ring off the label */
  }
  .fld__ctl::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--d-3) var(--ease-io);
    pointer-events: none;
  }
  .fld:focus-within .fld__ctl::after {
    transform: scaleX(1);
  }
  .fld input,
  .fld textarea {
    display: block;
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line-2);
    border-radius: var(--r-0);
    padding: 10px 0 12px;
    color: var(--fg);
    font-size: var(--t-lead);
    font-weight: 400;
    line-height: 1.35;
    caret-color: var(--fg);
    transition: border-color var(--d-1) var(--ease-out);
    /* focus() after a failed submit scrolls here: keep the field and its label clear of the fixed nav */
    scroll-margin-block: 140px 40px;
  }
  .fld textarea {
    min-height: 9.5em;
    resize: vertical;
  }
  .fld input:hover,
  .fld textarea:hover {
    border-bottom-color: var(--dim);
  }
  .fld input:-webkit-autofill {
    -webkit-text-fill-color: var(--fg);
    box-shadow: 0 0 0 100px var(--bg) inset;
  }
  .fld[data-invalid] input,
  .fld[data-invalid] textarea {
    border-bottom-color: var(--danger);
  }
  .fld[data-invalid] .fld__ctl::after {
    background: var(--danger);
  }
  .fld__err {
    min-height: 1.5em;
    margin-top: var(--s-2);
    color: var(--danger);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .fld__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
  }
  .fld__meta .num {
    flex: none;
  }
  .cf__send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
    margin-top: var(--s-2);
  }
  .cf__btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    width: 100%;
    min-height: 68px;
    padding: 0 var(--s-6);
    border: 1px solid var(--fg);
    color: var(--fg);
    font-size: clamp(1.15rem, 1.8vw, 1.6rem);
    font-weight: 600;
    font-stretch: 112%;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    transition: color var(--d-2) var(--ease-out);
  }
  .cf__btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--fg);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--d-3) var(--ease-io);
  }
  .cf__btn:hover,
  .cf__btn:focus-visible {
    color: var(--bg);
  }
  .cf__btn:hover::before,
  .cf__btn:focus-visible::before {
    transform: scaleY(1);
  }
  .cf__arr {
    transition: transform var(--d-3) var(--ease-out);
  }
  .cf__btn:hover .cf__arr,
  .cf__btn:focus-visible .cf__arr {
    transform: translateX(6px);
  }
  @media (min-width: 560px) {
    .cf__btn {
      width: auto;
      min-width: 300px;
    }
  }
  .cf__status {
    flex: 1 1 24ch;
    color: var(--fg-2);
  }
  .cf__open[hidden] {
    display: none;
  }
  .cf__open {
    display: inline-block;
    min-height: 24px;
    margin-left: var(--s-2);
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .foot__g {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    border-top: 1px solid var(--line);
    margin-top: clamp(40px, 6vw, 80px);
    padding-top: 26px;
  }
  .foot__g .m {
    display: block;
    margin-bottom: var(--s-2);
    color: var(--dim);
  }
  .foot__g a,
  .foot__g p {
    display: inline-block;
    min-height: 24px;
  }
  .foot__g p {
    color: var(--dim);
  }
  .foot__end {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: clamp(40px, 7vw, 90px);
  }
  .foot__end a {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
</style>
