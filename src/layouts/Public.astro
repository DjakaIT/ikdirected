---
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/base.css";
import Seo, { type SeoImage } from "../components/Seo.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: SeoImage | undefined;
  noindex?: boolean;
  current?: "home" | undefined;
  type?: "website" | "article";
}

const { title, description, path, image, noindex, current, type } = Astro.props;
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Runs before first paint: enables JS-only styles and decides on the first-visit loader (PD-05). Static text, hashed for CSP. -->
    <script is:inline>
      (function (d) {
        var h = d.documentElement;
        h.classList.add("js");
        try {
          if (
            location.pathname === "/" &&
            !sessionStorage.getItem("ik-seen") &&
            !matchMedia("(prefers-reduced-motion: reduce)").matches
          )
            h.classList.add("is-loading");
        } catch (e) {}
      })(document);
    </script>
    <Font cssVariable="--font-archivo" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-space-mono" />
    <Seo title={title} description={description} path={path} image={image} noindex={noindex} type={type} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip m" href="#sadrzaj">Prijeđi na sadržaj</a>
    <div class="grain" aria-hidden="true"></div>
    <slot name="overlay" />
    <Nav current={current} />
    <main id="sadrzaj" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <slot name="end" />
  </body>
</html>
